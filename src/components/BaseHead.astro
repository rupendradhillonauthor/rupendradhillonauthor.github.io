---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	contentType?: "website" | "article";
}

const {
  title,
  description,
  image,
  contentType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Default site-wide social image.
const defaultSocialImage = "/images/branding/site-social-default.png";

// Blog-specific fallback images.
const blogSocialImages: Record<string, string> = {
  "first-principles":
    "/images/branding/first-principles-social-default.png",

  "northern-compass":
    "/images/branding/northern-compass-social-default.png",

  "held-in-silence":
    "/images/branding/held-in-silence-social-default.png",

  "field-readings":
    "/images/branding/field-readings-social-default.png",
};

// Identify the blog from the first URL path segment.
const blogSlug = Astro.url.pathname.split("/").filter(Boolean)[0];

// Select the image using our established hierarchy.
const selectedImage =
  image ??
  blogSocialImages[blogSlug] ??
  defaultSocialImage;

// Handle both Astro ImageMetadata and static public images.
const imagePath =
  typeof selectedImage === "string"
    ? selectedImage
    : selectedImage.src;

// Generate an absolute URL against the production domain.
const socialImageURL = new URL(imagePath, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={contentType} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL.href} />

<!-- Twitter -->
 <meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL.href} />
<meta property="twitter:url" content={canonicalURL.href} />