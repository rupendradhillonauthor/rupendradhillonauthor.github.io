---
// src/components/Header.astro
import { SITE_TITLE } from "../consts";

// Explicitly import its isolated structural stylesheet
import "../styles/components/Header.css";

interface Props {
	backgroundColor?: string;
	HeaderBannerColor?: string;
	HeaderTaglineColor?: string;
	HeaderNavLinkColor?: string;
}

const {
	backgroundColor = "transparent",
	HeaderBannerColor = "var(--color-text-dark)",
	HeaderTaglineColor = "var(--color-text-dark)",
	HeaderNavLinkColor = "var(--color-text-dark)",
} = Astro.props;
---

<header
	class="editorial-header"
	style={`--header-bg: ${backgroundColor}; --hBanner-color: ${HeaderBannerColor}; --hTagLine-color:${HeaderTaglineColor}; --hNavLink-color:${HeaderNavLinkColor}`}
>
	<div class="header-top-row">
		<div class="header-banner">
			<h1><a href="/">{SITE_TITLE}</a></h1>
			<p class="header-tagline">
				Explorations at the edge of logic, language, and life.
			</p>
		</div>

		<button
			class="menu-toggle"
			id="menuToggle"
			aria-label="Toggle Navigation Menu"
		>
			<span class="hamburger-bar"></span>
			<span class="hamburger-bar"></span>
			<span class="hamburger-bar"></span>
		</button>
	</div>

	<nav class="header-nav" id="headerNav">
		<a href="/field-readings/">Field Readings</a>
		<a href="/first-principles">First Principles</a>
		<a href="/northern-compass">Northern Compass</a>
		<a href="/held-in-silence">Held in Silence</a>
		<a href="/magnificent-tales-of-doomed-kingdoms">Magnificent Tales</a>
		<a href="/about">About</a>
	</nav>
</header>

<script>
	const menuToggle = document.getElementById("menuToggle");
	const headerNav = document.getElementById("headerNav");

	if (menuToggle && headerNav) {
		menuToggle.addEventListener("click", () => {
			menuToggle.classList.toggle("is-active");
			headerNav.classList.toggle("is-visible");
		});
	}
</script>
