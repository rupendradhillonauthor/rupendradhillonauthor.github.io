---
import "../styles/components/ConversationNavigator.css";
---

<nav
  class="conversation-navigator"
  aria-label="Navigate conversation prompts"
  hidden
>
  <div class="conversation-navigator__markers">
    <button
      type="button"
      class="conversation-navigator__marker conversation-navigator__marker--top"
      aria-label="Return to top of article"
      title="Back to top"
    >
      <svg
        viewBox="0 0 16 16"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M8 3.5 L13.5 12 H2.5 Z" />
      </svg>
    </button>
  </div>
</nav>

<script>
  const navigator = document.querySelector<HTMLElement>(
    ".conversation-navigator"
  );

  const content = document.querySelector<HTMLElement>(
    ".blog-post-article--token-exchange .post-content"
  );

  if (navigator && content) {
    const prompts = Array.from(
      content.querySelectorAll<HTMLElement>(
        ".fr-token-exchange-conversation-prompt"
      )
    );

    const track = navigator.querySelector<HTMLElement>(
      ".conversation-navigator__markers"
    );

    const topMarker = track?.querySelector<HTMLButtonElement>(
      ".conversation-navigator__marker--top"
    );

    const article = content.closest<HTMLElement>(
      ".blog-post-article"
    );

    if (prompts.length > 0 && track && article && topMarker) {

      let activeScroll: number | undefined;

      const scrollToPrompt = (target: HTMLElement | "top") => {
        // Cancel any previous navigation animation.
        if (activeScroll !== undefined) {
          cancelAnimationFrame(activeScroll);
        }

        const startY = window.scrollY;

        const maxScroll = Math.max(
          0,
          document.documentElement.scrollHeight - window.innerHeight
        );

        const targetY =
          target === "top"
            ? 0
            : Math.max(
                0,
                Math.min(
                  startY +
                    target.getBoundingClientRect().top -
                    (parseFloat(getComputedStyle(target).scrollMarginTop) || 0),
                  maxScroll
                )
              );

        const distance = targetY - startY;

        // Respect the user's reduced-motion preference.
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          window.scrollTo({ top: targetY, behavior: "instant" });
          return;
        }

        const travelDistance = Math.abs(distance);

        // Distance-based cruising duration.
        const cruiseDuration = Math.min(
          1300,
          Math.max(550, travelDistance * 0.12)
        );

        // Distance-based acceleration duration.
        const easeInDuration = Math.min(
          1000,
          Math.max(150, travelDistance * 0.10)
        );

        // Distance-based deceleration duration.
        const easeOutDuration = Math.min(
          2000,
          Math.max(250, travelDistance * 0.20)
        );

        const totalDuration =
          easeInDuration + cruiseDuration + easeOutDuration;

        // Calculate maximum velocity.
        // Acceleration and deceleration each contribute half
        // their duration at maximum velocity (equivalent distance).
        const maxVelocity =
          distance /
          (cruiseDuration + (easeInDuration + easeOutDuration) / 2);

        // Calculate scroll displacement at a given elapsed time.
        const displacement = (elapsed: number): number => {

          // Phase 1: Constant acceleration.
          if (elapsed < easeInDuration) {
            return (
              maxVelocity *
              (elapsed * elapsed) /
              (2 * easeInDuration)
            );
          }

          // Phase 2: Constant velocity.
          if (elapsed < easeInDuration + cruiseDuration) {
            const cruisingTime = elapsed - easeInDuration;

            return maxVelocity * (
              easeInDuration / 2 + cruisingTime
            );
          }

          // Phase 3: Constant deceleration.
          const decelerationTime =
            elapsed - easeInDuration - cruiseDuration;

          return maxVelocity * (
            easeInDuration / 2 +
            cruiseDuration +
            decelerationTime -
            (decelerationTime * decelerationTime) /
              (2 * easeOutDuration)
          );
        };

        const startTime = performance.now();

        const animate = (now: number) => {
          const elapsed = Math.min(
            now - startTime,
            totalDuration
          );

          window.scrollTo({
            top: startY + displacement(elapsed),
            behavior: "instant",
          });

          if (elapsed < totalDuration) {
            activeScroll = requestAnimationFrame(animate);
          } else {
            activeScroll = undefined;
          }
        };

        activeScroll = requestAnimationFrame(animate);
      };

      topMarker.addEventListener("click", () => {
        scrollToPrompt("top");
      });

      // Generate one navigation marker per human prompt.
      const markers = prompts.map((prompt, index) => {
        const marker = document.createElement("button");

        marker.type = "button";
        marker.className = "conversation-navigator__marker";

        const preview = (prompt.textContent ?? "")
          .replace(/\s+/g, " ")
          .trim()
          .slice(0, 70);

        const label =
          `Prompt ${index + 1} of ${prompts.length}: ${preview}`;

        marker.setAttribute("aria-label", label);
        marker.title = label;

        marker.addEventListener("click", () => {
          scrollToPrompt(prompt);
        });

        track.appendChild(marker);

        return marker;
      });

      // Update positioning and active marker.
      const updateNavigator = () => {
        const articleBounds = article.getBoundingClientRect();
        const contentBounds = content.getBoundingClientRect();

        const left = articleBounds.right + 28;

        // Only show when sufficient horizontal space exists.
        const hasSpace =
          window.innerWidth >= 900 &&
          left + 42 <= window.innerWidth - 12;

        // Show while reading the conversation itself.
        const isReading =
          prompts[0].getBoundingClientRect().top <=
            window.innerHeight * 0.7 &&
          contentBounds.bottom >= window.innerHeight * 0.25;

        navigator.hidden = !hasSpace || !isReading;

        if (navigator.hidden) return;

        navigator.style.left = `${left}px`;

        // const trackHeight = track.clientHeight;
        // const contentHeight = Math.max(1, contentBounds.height);

        // // Position markers proportionally to their article locations.
        // markers.forEach((marker, index) => {
        //   const promptBounds = prompts[index].getBoundingClientRect();

        //   const relativePosition =
        //     (promptBounds.top - contentBounds.top) / contentHeight;

        //   const fraction = Math.max(
        //     0,
        //     Math.min(1, relativePosition)
        //   );

        //   marker.style.top =
        //     `${12 + fraction * (trackHeight - 24)}px`;
        // });

        const trackHeight = track.clientHeight;

        // Include the Top marker in the distribution.
        const slotHeight = trackHeight / (markers.length + 1);

        // Position the Top marker in the first slot.
        topMarker.style.top = `${slotHeight / 2}px`;

        // Distribute conversation prompts in the remaining slots.
        markers.forEach((marker, index) => {
          const position = (index + 1.5) * slotHeight;

          marker.style.top = `${position}px`;
        });

        // Identify the most recently encountered human prompt.
        let activeIndex = -1;

        prompts.forEach((prompt, index) => {
          if (
            prompt.getBoundingClientRect().top <=
            window.innerHeight * 0.35
          ) {
            activeIndex = index;
          }
        });

        const topIsActive = activeIndex === -1;

        topMarker.classList.toggle("is-active", topIsActive);

        if (topIsActive) {
          topMarker.setAttribute("aria-current", "location");
        } else {
          topMarker.removeAttribute("aria-current");
        }

        markers.forEach((marker, index) => {
          const active = index === activeIndex;

          marker.classList.toggle("is-active", active);

          if (active) {
            marker.setAttribute("aria-current", "location");
          } else {
            marker.removeAttribute("aria-current");
          }
        });
      };

      window.addEventListener(
        "scroll",
        updateNavigator,
        { passive: true }
      );

      window.addEventListener("resize", updateNavigator);

      updateNavigator();
    }
  }
</script>