---
// src/components/BlogHeader.astro
interface Props {
  title: string;
  manifesto: string;
  // Logo layout props (Optional)
  logoSrc?: string;
  logoAlt?: string;
  logoWidth?: string;
  // Hero layout props (Optional)
  heroImageSrc?: string;
  heroImageAlt?: string;
}

const {
  title,
  manifesto,
  logoSrc,
  logoAlt,
  logoWidth = "120",
  heroImageSrc,
  heroImageAlt,
} = Astro.props;

import "../styles/components/BlogHeader.css";
---

{/* Condition 1: Render the Hero Image if provided */}
{
  heroImageSrc && logoSrc && (
    <header class={`blog-publication-header-hero`}>
      <div class="publication-hero-wrapper-hero-image">
        <img
          src={heroImageSrc}
          alt={heroImageAlt}
          class="publication-hero-image"
        />
        <img
          src="/images/2025-11-20-landing/Person.jpg"
          alt="Person"
          class="hero-center"
        />
      </div>
      <div class="publication-text-content-hero-image">
        <div class="logo-title-row">
          <img
            src={logoSrc}
            alt={logoAlt}
            class="publication-logo-with-hero"
            style={`--logo-w: ${logoWidth}px;`}
          />
          <h1 class="publication-title">{title}</h1>
        </div>
        <p class="publication-manifesto">{manifesto}</p>
      </div>
    </header>
  )
}

{
  /* Condition 2: Render the small Logo if provided (and no hero image exists) */
}
{
  logoSrc && !heroImageSrc && (
    <header class={`blog-publication-header-logo`}>
      <div class="publication-text-content-logo">
        <div class="logo-title-row">
          <img
            src={logoSrc}
            alt={logoAlt}
            class="publication-logo"
            style={`--logo-w: ${logoWidth}px;`}
          />
          <h1 class="publication-title">{title}</h1>
        </div>
        <p class="publication-manifesto">{manifesto}</p>
      </div>
    </header>
  )
}
