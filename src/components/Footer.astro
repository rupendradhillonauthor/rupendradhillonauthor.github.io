---
// src/components/Footer.astro
const today = new Date();

// Explicitly import its strictly isolated, one-to-one stylesheet
import "../styles/components/Footer.css";

const hoverColor = "var(--color-footer-hover)"; // Define your parameterized color here
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-accent-line"></div>

		<div class="footer-socials">
			<a
				href="http://facebook.com/rupendradhillonauthor/"
				target="_blank"
				rel="noopener noreferrer"
				class="footer-icon-link"
				aria-label="Facebook"
				style={`--hover-color: ${hoverColor}`}
			>
				<svg viewBox="0 0 24 24" class="social-svg">
					<path
						d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"
					></path>
				</svg>
			</a>

			<a
				href="https://twitter.com/rdhillonauthor"
				target="_blank"
				rel="noopener noreferrer"
				class="footer-icon-link"
				aria-label="Twitter"
				style={`--hover-color: ${hoverColor}`}
			>
				<svg viewBox="0 0 24 24" class="social-svg">
					<path
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path>
				</svg>
			</a>

			<a
				href="mailto:rupendradhillonauthor@gmail.com"
				class="footer-icon-link"
				aria-label="Email"
				style={`--hover-color: ${hoverColor}`}
			>
				<svg viewBox="0 0 24 24" class="social-svg">
					<path
						d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
					></path>
				</svg>
			</a>

			<a
				href="/rss.xml"
				class="footer-icon-link"
				aria-label="Subscribe via RSS"
				target="_blank"
				style={`--hover-color: ${hoverColor}`}
			>
				<svg
					class="social-svg"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M4 11a9 9 0 0 1 9 9H9c0-2.76-2.24-5-5-5v-4zm0-7a16 16 0 0 1 16 16h-4a12 12 0 0 0-12-12V4zm2 14a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"
					></path>
				</svg>
			</a>
		</div>

		<div class="footer-attribution">
			<p>&copy; {today.getFullYear()} Rupendra Dhillon</p>
		</div>
	</div>
</footer>
