---
// src/layouts/BlogPostNoHeroImage.astro
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import "../styles/layouts/BlogPost.css";

interface Props {
	title: string;
	date: Date | string;
	coverImage?: ImageMetadata;
	excerpt?: string;
	backgroundColor?: string;
	backLinkUrl: string;
	backLinkText: string;
	prevPost?: any; // Accepting the post object
	nextPost?: any;
}

const {
	title,
	date,
	coverImage,
	excerpt,
	backgroundColor = "transparent",
	backLinkUrl,
	backLinkText,
	prevPost,
	nextPost,
} = Astro.props;

// Helper to format the date exactly like your screenshot (e.g., December 11, 2024)
const formattedDate = new Date(date)
	.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	})
	.replace(",", "");
---

<BaseLayout
	title={title}
	description={excerpt}
	backgroundColor={backgroundColor}
	pageType="narrow"
>
	<article class="blog-post-article">
		<nav class="post-back-nav">
			<a href={backLinkUrl} class="back-link">&larr; {backLinkText}</a>
		</nav>
		<header class="post-header">
			<p class="poem-date">{formattedDate}</p>
			<h1 class="poem-title">{title}</h1>
		</header><div class="post-content"><slot /></div>

		<footer class="post-navigation">
			<div class="nav-links">
				{
					prevPost ? (
						<a href={`/held-in-silence/${prevPost.id}`} class="nav-prev">
							<span class="nav-label">&larr; Previous</span>
							<span class="nav-title">{prevPost.data.title}</span>
						</a>
					) : (
						<div />
					)
				}

				{
					nextPost ? (
						<a href={`/held-in-silence/${nextPost.id}`} class="nav-next">
							<span class="nav-label">Next &rarr;</span>
							<span class="nav-title">{nextPost.data.title}</span>
						</a>
					) : (
						<div />
					)
				}
			</div>
		</footer>
	</article>
</BaseLayout>
