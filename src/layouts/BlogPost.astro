---
// src/layouts/BlogPostLayout.astro
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import "../styles/layouts/BlogPost.css";

interface Props {
	title: string;
	date: Date | string;
	coverImage?: ImageMetadata;
	excerpt?: string;
	backgroundColor?: string;
	backLinkUrl: string;
	backLinkText: string;
	prevPost?: any; // Accepting the post object
	nextPost?: any;
}

const {
	title,
	date,
	coverImage,
	excerpt,
	backgroundColor = "transparent",
	backLinkUrl,
	backLinkText,
	prevPost,
	nextPost,
} = Astro.props;

// 1. Get the current URL path (e.g., "/held-in-silence/the-web" or "/blog/first-post")
const pathname = Astro.url.pathname;

// 2. Extract the collection segment safely (the first directory after the domain root)
const pathSegments = pathname.split("/").filter(Boolean);
const collectionSlug = pathSegments[0] || "blog"; // Fallback to 'blog' if root

// 3. Format a clean display name (e.g., "held-in-silence" becomes "Held In Silence")
const collectionDisplayName = collectionSlug
	.split("-")
	.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
	.join(" ");

// Helper to format the date exactly like your screenshot (e.g., December 11, 2024)
const formattedDate = new Date(date).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
---

<BaseLayout
	title={title}
	description={excerpt}
	backgroundColor={backgroundColor}
	pageType="narrow"
>
	<article class="blog-post-article">
		<nav class="post-back-nav">
			<a href={backLinkUrl} class="back-link">&larr; {backLinkText}</a>
		</nav>

		<header class="post-header">
			<h1 class="post-title">{title}</h1>
			<hr class="post-divider" />
			<p class="post-date">{formattedDate}</p>

			{
				coverImage && (
					<div class="post-cover-wrapper">
						<Image
							src={coverImage}
							alt={`Cover image for ${title}`}
							class="post-cover-image"
							width={1000}
							height={560}
							loading="eager"
						/>
					</div>
				)
			}
		</header>

		<div class="post-content">
			<slot />
		</div>

		<footer class="post-navigation">
			<div class="nav-links">
				{
					prevPost ? (
						<a href={`/${collectionSlug}/${prevPost.id}`} class="nav-prev">
							<span class="nav-label">&larr; Previous</span>
							<span class="nav-title">{prevPost.data.title}</span>
						</a>
					) : (
						<div />
					)
				}

				{
					nextPost ? (
						<a href={`/${collectionSlug}/${nextPost.id}`} class="nav-next">
							<span class="nav-label">Next &rarr;</span>
							<span class="nav-title">{nextPost.data.title}</span>
						</a>
					) : (
						<div />
					)
				}
			</div>
		</footer>
	</article>
</BaseLayout>
