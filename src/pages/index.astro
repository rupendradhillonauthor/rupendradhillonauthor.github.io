---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";

// Import the dedicated page stylesheet
import "../styles/pages/index.css";
---

<BaseLayout
	title="Home"
	pageType="standard"
	backgroundColor="var(--canvas-landing)"
>
	<header class="manifesto-section">
		<h2 class="tagline">
			I write to unravel patterns — in myth, mind, and matter.
		</h2>
		<p class="author-sub">
			Author. Systems thinker. Stranger in Stranger Lands.
		</p>
	</header>

	<section class="blog-directory-grid">
		<BlogCard
			title="First Principles"
			url="/first-principles"
			excerpt1="Here, no idea is too early, too strange, or too foundational to question. A space for deep, unhurried thought — a search for clarity at the intersection of physics, mind, meaning, and method."
			excerpt2="Not answers, but frameworks. Not noise, but signals worth chasing."
			linkText="Explore the Blog"
			imageSrc="/images/2025-11-20-landing/Logo+-+Minimal+-+Transparent.png"
			imageAlt="Ocean waves crashing against rocks"
			imageHeight="106.6"
			imageWidth="47.8"
		/>
		<BlogCard
			title="Northern Compass"
			url="/northern-compass"
			excerpt1="Thoughts on direction and consequence in Canadian politics – from forces that shape everyday life to decisions that define Canada’s role in the world."
			linkText="Explore Perspectives"
			imageSrc="/images/2025-11-20-landing/Logo+-+Transparent+BG+-+BW+needle.png"
			imageAlt="A brass compass pointing north"
			imageHeight="106.6"
			imageWidth="47.8"
		/>
		<BlogCard
			title="Held in Silence"
			url="/held-in-silence"
			excerpt1="A space for the smallest stillness and the fiercest quiet. A haunt of voices that tremble, rage, or rest – each entered in silence, and remaining."
			excerpt2="Here, poetry listens first."
			linkText="Enter stillness"
			imageSrc="/images/2025-11-20-landing/Logo3.png"
			imageAlt="A quiet path through a dense forest"
			imageHeight="107"
			imageWidth="106.6"
		/>
	</section>

	<section class="hero-book-feature">
		<div class="book-cover-column">
			<a href="/magnificent-tales-of-doomed-kingdoms">
				<img
					src="https://images.squarespace-cdn.com/content/v1/62b93605415bfd5c9b49056b/1656305158710-2QHXU7LCWG7KHU00545C/Magnificent+Tales+of+Doomed+Kingdoms_Front+Cover_V2_JPG.jpg"
					alt="Book Cover"
					class="hero-book-image"
				/>
			</a>
		</div>

		<div class="book-details-column">
			<h2 class="book-title">Magnificent Tales of Doomed Kingdoms</h2>
			<div class="book-description">
				<p>
					Experience the personal struggles of the rulers trying to bring up
					their children so that they can become rightful rulers in a world
					surrounded by their enemies. A telling of victories that are worth
					nothing compared to the unrecoverable losses. Let your mind witness
					acts that would otherwise be considered unimaginable and of the turns
					of fate that can spell disaster for the kingdom.
				</p>
			</div>
			<a href="/magnificent-tales-of-doomed-kingdoms" class="explore-link"
				>Explore details &rarr;</a
			>
		</div>
	</section>
</BaseLayout>
