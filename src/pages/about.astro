---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro"; // Assuming your header component name
import "../styles/pages/about.css";

const backgroundColor = "var(--color-text-dark)";
const HeaderBannerColor = "var(--color-text-light)";
const HeaderTaglineColor = "var(--color-text-light-muted)";
const HeaderNavLinkColor = "var(--color-text-light)";
---

<BaseLayout
  title="About | Rupendra Dhillon"
  description="Software developer, systems architect, and author based in Ontario."
  backgroundColor={backgroundColor}
  HeaderBannerColor={HeaderBannerColor}
  HeaderTaglineColor={HeaderTaglineColor}
  HeaderNavLinkColor={HeaderNavLinkColor}
>
  <div class="about-hero-wrapper">
    <img
      src="/images/about/Statues.jpg"
      alt="Scenic Horizon Background"
      class="about-hero-bg-image"
    />
  </div>

  <main class="about-page-wrapper">
    <div class="about-grid">
      <div class="about-text-column">
        <h1><span>About Me</span></h1>
        <p>
          I was born in New Delhi, India, observed, at a very early age, my
          father burning the midnight oil on his trusty writing pad and
          Remington typewriter.
        </p>
        <p>
          Now I am settled in the rural outskirts of Toronto, Canada, with my
          wife and two dogs. I seem to have taken up a hobby very similar to my
          father’s. My aim is to tell stories that grab the reader’s attention
          and pack an emotional punch.
        </p>
      </div>

      <div class="about-image-column">
        <img
          src="/images/about/portrait.jpeg"
          alt="Rupendra Dhillon Portrait"
          class="about-portrait"
        />
      </div>
    </div>
  </main>
</BaseLayout>
